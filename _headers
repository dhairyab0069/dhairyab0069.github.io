/*.html
  Cache-Control: public, max-age=0, must-revalidate
# ES modules are not content-hashed, so a long immutable TTL lets a browser mix
# cached and fresh modules into an inconsistent graph. Revalidate these instead.
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.gif
  Cache-Control: public, max-age=31536000, immutable
