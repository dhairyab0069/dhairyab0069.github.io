# Cloudflare Pages cache rules

# HTML — always revalidate so updates go live immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS — cache 1 year (bust by renaming file when you change it)
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images — cache 1 year
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Fonts loaded from fontshare CDN are already cached externally
